<Window x:Class="SistemaLojaVirtual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loja Virtual" Height="720" Width="1200" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Language="pt-BR"
        Background="{StaticResource CorFundo}" FontFamily="Segoe UI">
    <DockPanel>

        <!-- ===== Topo: logo + menu + carrinho ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CorTopo}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <Border Background="{StaticResource CorDestaque}" CornerRadius="8" Width="36" Height="36">
                        <TextBlock Text="&#xE719;" FontFamily="{StaticResource Icones}" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Loja Virtual" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="compre sem sair de casa" Foreground="#A5B4FC" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="menuLoja" Content="Loja" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />
                    <RadioButton x:Name="menuPedidos" Content="Pedidos" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />

                    <Border Width="1" Background="#4338CA" Margin="12,6" />
                    <TextBlock Text="ADMIN" Foreground="#818CF8" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0" />

                    <RadioButton x:Name="menuProdutos" Content="Produtos" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />
                    <RadioButton x:Name="menuCategorias" Content="Categorias" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />
                    <RadioButton x:Name="menuClientes" Content="Clientes" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />
                    <RadioButton x:Name="menuRelatorios" Content="Relatórios" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" />
                </StackPanel>

                <!-- Carrinho (clicar leva para a loja) -->
                <Button Grid.Column="2" Click="Carrinho_Click" Background="{StaticResource CorTopoClara}"
                        Padding="12,8" ToolTip="Ver carrinho">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Icones}" FontSize="18"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Carrinho" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{StaticResource CorDestaque}" CornerRadius="10" MinWidth="22" Padding="6,1">
                            <TextBlock x:Name="lblQuantidadeCarrinho" Text="0" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Conteúdo da página escolhida no menu ===== -->
        <ContentControl x:Name="conteudo" />
    </DockPanel>
</Window>