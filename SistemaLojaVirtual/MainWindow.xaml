<Window x:Class="SistemaLojaVirtual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema Loja Virtual" Height="600" Width="1050"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="abas" SelectionChanged="Abas_SelectionChanged" Margin="6">
        <TabItem x:Name="abaPedidos" Header="Pedidos" />
        <TabItem x:Name="abaClientes" Header="Clientes" />
        <TabItem x:Name="abaProdutos" Header="Produtos" />
        <TabItem x:Name="abaCategorias" Header="Categorias" />
        <TabItem x:Name="abaRelatorios" Header="Relatórios (SQL)" />
    </TabControl>
</Window>
