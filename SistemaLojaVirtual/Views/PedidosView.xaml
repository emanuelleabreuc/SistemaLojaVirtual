<UserControl x:Class="SistemaLojaVirtual.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Pedidos" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Histórico de todas as compras realizadas na loja." Style="{StaticResource SubtituloPagina}" />
        </StackPanel>

        <!-- Indicadores -->
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Cartao}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="PEDIDOS" Style="{StaticResource Rotulo}" />
                    <TextBlock x:Name="lblTotalPedidos" Text="0" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Cartao}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="FATURAMENTO" Style="{StaticResource Rotulo}" />
                    <TextBlock x:Name="lblFaturamento" Text="R$ 0,00" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource CorSucesso}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Cartao}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="TICKET MÉDIO" Style="{StaticResource Rotulo}" />
                    <TextBlock x:Name="lblTicketMedio" Text="R$ 0,00" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Cartao}" Padding="0">
            <DataGrid x:Name="gridPedidos" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" />
                    <DataGridTextColumn Header="Itens" Binding="{Binding QuantidadeItens}" Width="70" />
                    <DataGridTextColumn Header="Pagamento" Binding="{Binding FormaPagamento}" Width="130" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120" />
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left">
                                    <TextBlock Text="Pago" Foreground="{StaticResource CorSucessoEscura}"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
